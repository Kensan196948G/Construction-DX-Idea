# Frontend
VITE_API_BASE_URL=https://dxidea.mirai-dx-platform.com/api
VITE_USE_MOCK_API=true

# Cloudflare Workers secrets must be configured with wrangler secret put.
# Do not place real secrets in this file.
#
ALLOWED_ORIGINS=
ALLOW_LOCAL_AUTH_BYPASS=false
APP_BASE_URL=https://dxidea.mirai-dx-platform.com
ADMIN_EMAILS=
CF_ACCESS_AUD=
CF_ACCESS_CERTS_URL=
CF_ACCESS_ISSUER=
AI_INPUT_COST_PER_1K_TOKENS=0.003
AI_OUTPUT_COST_PER_1K_TOKENS=0.015
DATABASE_URL=
ANTHROPIC_API_KEY=
SLACK_WEBHOOK_URL=
SYSTEM_ADMIN_EMAILS=

# Cloudflare Pages deploy requires a logged-in wrangler profile and target project name.
# For deployment script, set CLOUDFLARE_PAGES_PROJECT only.
CLOUDFLARE_PAGES_PROJECT=
