# Frontend
# Origin only — request paths already include /api (a /api suffix here would
# double the prefix and 404; predeploy:check rejects it).
VITE_API_BASE_URL=https://dxidea.mirai-dx-platform.com
VITE_USE_MOCK_API=true

# ---------------------------------------------------------------------------
# DB: ローカル PostgreSQL（Neon は廃止済み。2026-08-31 移行完了、本番DBは
# migration 001-009 適用済み 2026-09-04）
#
# 現行配信は Cloudflare Tunnel → ローカル systemd サービス
# （dx-idea-api.service / dx-idea-mvp-api.service）が localhost の PostgreSQL へ
# 接続する構成。worker/index.ts は接続URLのホストでドライバを自動選択し
# （neon.tech 以外は postgres.js TCP）、ローカルDBはそのまま postgres.js で接続。
#
#   本番ローカルDB: postgresql://<user>:<pass>@127.0.0.1:5432/dx_idea
#   MVP ローカルDB: postgresql://<user>:<pass>@127.0.0.1:5432/dx_idea_mvp
#   migration: npm run db:migrate（scripts/migrate-local.mjs、冪等・再実行安全）
#
# Cloudflare Workers で動かす場合のみ、wrangler secret put で secrets を設定。
# Do not place real secrets in this file.
#
ALLOWED_ORIGINS=
ALLOW_LOCAL_AUTH_BYPASS=false
APP_BASE_URL=https://dxidea.mirai-dx-platform.com
ADMIN_EMAILS=
CF_ACCESS_AUD=
CF_ACCESS_CERTS_URL=
CF_ACCESS_ISSUER=
AI_INPUT_COST_PER_1K_TOKENS=0.003
AI_OUTPUT_COST_PER_1K_TOKENS=0.015
# ローカル PostgreSQL の接続文字列を設定する（例）
# DATABASE_URL=postgresql://dxidea_app:***@127.0.0.1:5432/dx_idea
DATABASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SLACK_WEBHOOK_URL=
SYSTEM_ADMIN_EMAILS=

# ローカル実行サーバー（npm run dev:server）向け（任意）
# PORT=8791
# HOST=127.0.0.1
# MAX_BODY_BYTES=1048576
