{
  "name": "construction-dx-idea",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted DX idea management system for civil engineering and construction teams.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:frontend": "vite build",
    "build:production-api": "VITE_USE_MOCK_API=false npm run build",
    "build:mvp": "VITE_USE_MOCK_API=false VITE_API_BASE_URL=https://dxidea-mvp.mirai-dx-platform.com VITE_DEMO_BANNER=true vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "lint": "eslint .",
    "security:scan": "node scripts/security-scan.mjs",
    "predeploy:check": "node scripts/predeploy-check.mjs",
    "verify": "npm run lint && npm run test && npm run build && npm run build:production-api && npm run security:scan",
    "release:monitor": "node scripts/release-readiness-monitor.mjs",
    "worker:dev": "wrangler dev worker/index.ts",
    "worker:deploy:dry-run": "wrangler deploy worker/index.ts --dry-run",
    "worker:deploy": "wrangler deploy worker/index.ts",
    "mvp:dry-run": "npm run build:mvp && wrangler deploy --env mvp --dry-run",
    "mvp:deploy": "npm run build:mvp && wrangler deploy --env mvp",
    "mvp:seed": "node scripts/mvp-seed.mjs",
    "mvp:smoke": "node scripts/mvp-smoke.mjs",
    "release:prepare": "npm run build:production-api && npm run predeploy:check && npm run worker:deploy:dry-run",
    "release:smoke": "node scripts/release-smoke-test.mjs",
    "release:gate": "npm run release:monitor && npm run release:prepare && npm run release:smoke",
    "release:deploy": "export RELEASE_DEPLOY_CHECK=1 && npm run release:monitor && npm run release:prepare && npm run worker:deploy && npm run release:smoke"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@neondatabase/serverless": "^1.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "hono": "^4.10.7",
    "lucide-react": "^0.561.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260712.1",
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
